# ElSi server configuration. Copy to .env (never commit it) or set these in deploy/.env.
# Empty values mean "unset".

# --- runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# --- database
# postgres://user:password@host:5432/db   (production: Postgres 17 + pgvector)
# pglite://memory                          (zero-setup, data lost on restart)
# pglite:///absolute/path/to/dir           (zero-setup, persisted to a directory)
DATABASE_URL=postgres://elsi:change-me@postgres:5432/elsi

# --- auth
# Required in production, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
# Needed by every user after the first to register. Leave empty to close registration.
INVITE_CODE=
# Requests per minute per IP on /auth/register, /auth/login and /auth/refresh (0 = no limit).
AUTH_RATE_LIMIT_PER_MIN=10

# --- files and networking
# Uploaded attachments, stored as <FILES_DIR>/<sha[0:2]>/<sha256>.
FILES_DIR=./data/files
# Public base URL of the API, e.g. https://elsi.example.ts.net
PUBLIC_URL=
# Set when running behind Caddy/another proxy so client IPs (rate limits, audit) are real:
# true, a hop count (1), or a comma-separated list of proxy addresses/CIDRs.
TRUST_PROXY=false

# --- AI (optional; AI routes answer 503 ai_not_configured without a key)
ANTHROPIC_API_KEY=
AI_MONTHLY_TOKEN_BUDGET=2000000
# ollama | voyage | none
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=
OLLAMA_URL=http://ollama:11434
VOYAGE_API_KEY=

# --- voice notes (optional, faster-whisper HTTP service)
WHISPER_URL=
WHISPER_MODEL=
